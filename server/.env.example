PORT=5001

# Supabase (PostgreSQL) -------------------------------------------------
# Dashboard -> Connect -> Connection string (URI) -> Session pooler (port 6543)
# Use the session pooler URL from a local/dev machine (direct IPv6 connections
# often fail outside Supabase's network).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

DEFAULT_ADMIN_PASSWORD=change-this-password
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=owner@example.com
DEFAULT_MANAGER_PASSWORD=change-this-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
SHIFT_REPORT_EMAIL=owner@example.com

# Bill retention: auto-delete bills 4 years after created_at
BILL_PURGE_INTERVAL_HOURS=6
BILL_STORAGE_BUCKET=bills
